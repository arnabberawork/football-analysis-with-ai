GEMINI_API_KEY="<your GEMINI API KEY>"
HF_API_KEY="<your HF API KEY>"

# Optional - override the Gemini model tier used across the pipeline.
# If unset, these default to the values below (see src/football_rag/agents/_llm.py).
#
# GEMINI_MODEL is used by ReasoningAgent, GeneratorAgent, EvaluatorAgent, AND
# NaiveRAGGenerator (the naive baseline) - deliberately the *same* model
# across naive and agentic so the naive-vs-agentic comparison isolates
# architecture differences, not model differences. Don't set this to
# different values for different runs if you're comparing naive vs agentic.
# GEMINI_MODEL=gemini-3.5-flash

# GEMINI_MODEL_LITE is used only by QueryUnderstandingAgent (a simpler
# extraction task than reasoning/generation/evaluation, so a lighter/cheaper
# model is used deliberately - this one is not part of the naive/agentic
# model-parity requirement above).
# GEMINI_MODEL_LITE=gemini-3.5-flash-lite
